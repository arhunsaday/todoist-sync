{
  "name": "todoist-to-google-calendar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "list-ids": "tsx src/scripts/list-ids.ts",
    "reconcile:once": "tsx src/scripts/reconcile-once.ts",
    "rebuild-links": "tsx src/scripts/rebuild-links.ts",
    "full-sync": "tsx src/scripts/full-sync.ts",
    "dev:saas": "pnpm --filter @accord/web dev",
    "build:saas": "pnpm --filter @accord/web build",
    "typecheck:saas": "pnpm -r --filter \"@accord/*\" typecheck",
    "test:saas": "vitest run --config vitest.saas.config.ts",
    "test:worker": "pnpm --filter @accord/worker test",
    "test:browser": "playwright test",
    "db:local": "pnpm --filter @accord/worker db:local"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "googleapis": "^174.0.1",
    "hono": "^4.13.1",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.1",
    "node-gyp": "^13.1.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "packageManager": "pnpm@10.34.6"
}
