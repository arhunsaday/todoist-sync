{
  "name": "todoist-to-google-calendar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "list-ids": "tsx src/scripts/list-ids.ts",
    "reconcile:once": "tsx src/scripts/reconcile-once.ts",
    "rebuild-links": "tsx src/scripts/rebuild-links.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "googleapis": "^174.0.1",
    "hono": "^4.13.1",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
