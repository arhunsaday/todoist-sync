{
	"name": "accord",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-15",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "../web/dist/client",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		],
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "accord-local",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations",
		},
		{
			"binding": "accord_production",
			"database_name": "accord-production",
			"database_id": "6eaa7548-38a3-44c2-a2c3-d90116aa2472",
			"remote": true
		},
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "SYNC_COORDINATOR",
				"class_name": "SyncCoordinator",
			},
		],
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"SyncCoordinator"
			],
		},
	],
	"queues": {
		"producers": [
			{
				"binding": "SYNC_QUEUE",
				"queue": "accord-sync",
			},
		],
		"consumers": [
			{
				"queue": "accord-sync",
				"max_batch_size": 5,
				"max_retries": 5,
			},
		],
	},
	"triggers": {
		"crons": [
			"*/15 * * * *"
		],
	},
	"vars": {
		"PUBLIC_URL": "http://127.0.0.1:5173",
		"STRIPE_PRICE_AMOUNT": "6",
		"STRIPE_PRICE_CURRENCY": "EUR",
	},
}