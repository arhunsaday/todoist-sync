// Typechecking config. The build config excludes *.test.ts so they stay out of
// dist/; this one includes them, because a type error in a test is still a bug
// — vitest strips types without checking them, so nothing else would catch it.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "."
  },
  "include": ["src/**/*.ts"],
  "exclude": []
}
