# Server
PORT=3000
# Public HTTPS origin where webhooks are reachable. Google will not deliver
# push notifications to a self-signed or invalid certificate.
PUBLIC_URL=https://sync.example.com
LOG_LEVEL=info

# Guards the web UI and its API with HTTP basic auth (username: admin).
# SET THIS. Without it the OAuth setup pages are open to anyone who finds the
# URL, and completing that flow REPLACES your stored token — pointing the sync
# at someone else's calendars. Settings cannot be saved until it is set.
#   openssl rand -hex 24
ADMIN_TOKEN=
# Local default. In a container this MUST be an absolute path inside the
# mounted volume (the image defaults to /data/sync.db) — a relative path
# resolves into the app directory, which is not writable and would not survive
# a redeploy anyway. Do not copy this line into Railway.
DATABASE_PATH=./data/sync.db

# Google API credentials (personal Google Cloud project, Calendar API enabled)
# Publish the OAuth consent screen to "In production" — in "Testing" status
# refresh tokens expire after 7 days and the sync silently dies each week.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://sync.example.com/setup/google/callback

# Todoist OAuth app (App Management console).
# Webhooks only fire for OAuth-authorized apps; a personal API token will not
# trigger them. The client secret also verifies the webhook HMAC signature.
TODOIST_CLIENT_ID=your-todoist-client-id
TODOIST_CLIENT_SECRET=your-todoist-client-secret
TODOIST_REDIRECT_URI=https://sync.example.com/setup/todoist/callback
# Optional: lets `pnpm list-ids` run before the OAuth flow is set up.
TODOIST_API_TOKEN=your-todoist-personal-token

# Pairs, comma separated: todoistProjectId:googleCalendarId
#
# OPTIONAL. Leave empty and pair projects with calendars in the web UI (Pairs
# tab) once both providers are connected. Anything saved in the UI is stored
# in the database and overrides this variable; it only seeds the first boot.
# The same goes for the behaviour options below, except those marked env-only.
SYNC_MAPPINGS=

# Behaviour
DEFAULT_EVENT_DURATION_MINUTES=60
SYNC_FOREIGN_EVENTS=true
# env-only
SYNC_RECURRING_FOREIGN_EVENTS=false

# Prepend !p1 / !p2 / !p3 to event titles for Todoist p1 / p2 / p3.
# Markdown links in task names are always flattened to their text, so a long
# URL does not swamp the calendar title.
PRIORITY_PREFIXES=true

# Prepend a marker when a label matches. `match:prefix` pairs; the match
# ignores emoji, spaces, and punctuation, so `⚡ 5min` and `5 min` both match
# `5min` — while `15min` and `45min` deliberately do not.
LABEL_PREFIXES=5min:@5min,30min:@30min,urgent:@urg

# Append task comments to the event description.
SYNC_COMMENTS=true

# Circuit breaker. Deleting a calendar event is read as "task done", so clearing
# a calendar would complete every matching task. If a single sync pass would
# complete more than this many, the whole pass is refused and the sync cursor
# left untouched — nothing applied, nothing lost — and the calendar is reported
# in /health as blocked. Set 0 to disable.
MAX_COMPLETIONS_PER_SYNC=25
# env-only
RECONCILE_INTERVAL_MINUTES=15
# env-only
WATCH_RENEW_WITHIN_HOURS=48
